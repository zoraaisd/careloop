NODE_ENV=development
PORT=4000
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
TRUST_PROXY=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=meditracker
DB_LOGGING=false
DB_AUTO_INITIALIZE=false
DB_RUN_MIGRATIONS=false
BOOTSTRAP_ADMIN_ON_START=true
BOOTSTRAP_ADMIN_NAME=Admin User
BOOTSTRAP_ADMIN_EMAIL=admin123@gmail.com
BOOTSTRAP_ADMIN_PHONE=+910000000000
BOOTSTRAP_ADMIN_PASSWORD=admin123
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
