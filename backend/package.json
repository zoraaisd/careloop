{
  "name": "meditracker-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready backend setup for medittracker.",
  "main": "dist/server.js",
  "scripts": {
    "predev": "node scripts/free-port.js",
    "dev": "ts-node --files src/server.ts",
    "dev:nodemon": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "import:legacy-json": "ts-node --files scripts/import-legacy-json.ts",
    "typeorm": "node --require ts-node/register ./node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@emailjs/nodejs": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@vitalets/google-translate-api": "^9.2.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "puppeteer-core": "^24.42.0",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.6",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
